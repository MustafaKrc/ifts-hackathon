# Jira (read-only access)
JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_AUTH_MODE=bearer
JIRA_PROJECT_KEY=POS
# Optional: explicit historical sprint names. Leave empty to auto-discover the
# last N sprints from the Agile API (recommended).
JIRA_HISTORICAL_SPRINTS=
# How many recent sprints to include in backlog filter + historical similarity.
JIRA_SPRINT_WINDOW=10
JIRA_VERIFY_SSL=false
JIRA_SP_FIELD=customfield_10028
# Sprint field on the issue (varies by Jira instance). Common values:
# customfield_10020 (Server/DC), customfield_10010 (some Cloud instances).
JIRA_SPRINT_FIELD=customfield_10020

# OpenAI Priority Advisor (optional - app works without it via deterministic fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
